{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "世事",
  "mainBinaryName": "MYIA",
  "version": "0.0.3",
  "identifier": "com.myssia.app",
  "build": {
    "beforeBuildCommand": "npm run clean:pycache && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "世事",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "focus": false,
        "backgroundColor": "#10131a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../config/ai-news.yaml": "config/ai-news.yaml",
      "../../config/ai-token-deals.yaml": "config/ai-token-deals.yaml",
      "../../config/ai-vendor-watch.yaml": "config/ai-vendor-watch.yaml",
      "../../config/credentials.yaml": "config/credentials.yaml",
      "../../config/daily-digest.yaml": "config/daily-digest.yaml",
      "../../config/exposure.yaml": "config/exposure.yaml",
      "../../config/games.yaml": "config/games.yaml",
      "../../config/gpu-prices.yaml": "config/gpu-prices.yaml",
      "../../config/monitor.yaml": "config/monitor.yaml",
      "../../config/myssia-demo.yaml": "config/myssia-demo.yaml",
      "../../config/news.yaml": "config/news.yaml",
      "../../config/stocks.yaml": "config/stocks.yaml",
      "../../config/telegram-channels.yaml": "config/telegram-channels.yaml",
      "../../config/telegram-groups.yaml": "config/telegram-groups.yaml",
      "../../config/telegram-web.yaml": "config/telegram-web.yaml",
      "../../config/weixin.yaml": "config/weixin.yaml",
      "../../config/wool.yaml": "config/wool.yaml",
      "../../plugins/myssia-credhunter/README.md": "plugins/myssia-credhunter/README.md",
      "../../plugins/myssia-credhunter/plugin.yaml": "plugins/myssia-credhunter/plugin.yaml",
      "../../plugins/myssia-firecrawl/README.md": "plugins/myssia-firecrawl/README.md",
      "../../plugins/myssia-firecrawl/plugin.yaml": "plugins/myssia-firecrawl/plugin.yaml",
      "../../plugins/myssia-maigret/README.md": "plugins/myssia-maigret/README.md",
      "../../plugins/myssia-maigret/plugin.yaml": "plugins/myssia-maigret/plugin.yaml",
      "../../plugins/myssia-media/README.md": "plugins/myssia-media/README.md",
      "../../plugins/myssia-media/plugin.yaml": "plugins/myssia-media/plugin.yaml",
      "../../plugins/myssia-mediacrawler/README.md": "plugins/myssia-mediacrawler/README.md",
      "../../plugins/myssia-mediacrawler/plugin.yaml": "plugins/myssia-mediacrawler/plugin.yaml",
      "../../plugins/myssia-osint/README.md": "plugins/myssia-osint/README.md",
      "../../plugins/myssia-osint/plugin.yaml": "plugins/myssia-osint/plugin.yaml",
      "../../plugins/myssia-proxy/README.md": "plugins/myssia-proxy/README.md",
      "../../plugins/myssia-proxy/plugin.yaml": "plugins/myssia-proxy/plugin.yaml",
      "../../plugins/myssia-snownlp/README.md": "plugins/myssia-snownlp/README.md",
      "../../plugins/myssia-snownlp/plugin.yaml": "plugins/myssia-snownlp/plugin.yaml",
      "../../plugins/myssia-theharvester/README.md": "plugins/myssia-theharvester/README.md",
      "../../plugins/myssia-theharvester/plugin.yaml": "plugins/myssia-theharvester/plugin.yaml",
      "../../plugins/myssia-urlwatch/README.md": "plugins/myssia-urlwatch/README.md",
      "../../plugins/myssia-urlwatch/plugin.yaml": "plugins/myssia-urlwatch/plugin.yaml",
      "../../plugins/myssia-yake/README.md": "plugins/myssia-yake/README.md",
      "../../plugins/myssia-yake/plugin.yaml": "plugins/myssia-yake/plugin.yaml",
      "../../src/myssia": "myssia-src/myssia",
      "../entry.py": "myssia-src/entry.py",
      "../fixture/plugin.yaml": "plugin.yaml",
      "../myssia_desktop_entry": "myssia-src/myssia_desktop_entry",
      "../resources/components.json": "components.json",
      "../resources/plugins.lock.json": "plugins.lock.json",
      "../resources/requirements-lock.txt": "requirements-lock.txt",
      "../resources/runtime-manifest.json": "runtime-manifest.json",
      "../../plugins/wechat-bridge": "components/wechat-bridge"
    },
    "category": "DeveloperTool",
    "shortDescription": "myssia — AI-native intelligence hub"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xinzhuzi/myia/releases/latest/download/latest.json"
      ],
      "pubkey": "__MYSSIA_UPDATER_PUBKEY_PLACEHOLDER__",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "世事",
  "mainBinaryName": "MYIA",
  "version": "0.0.1",
  "identifier": "com.myssia.app",
  "build": {
    "beforeBuildCommand": "npm run clean:pycache && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "世事",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../fixture/plugin.yaml": "plugin.yaml",
      "../../plugins/ai-news.yaml": "plugins/ai-news.yaml",
      "../../plugins/wool.yaml": "plugins/wool.yaml",
      "../../plugins/stocks.yaml": "plugins/stocks.yaml",
      "../../plugins/gpu-prices.yaml": "plugins/gpu-prices.yaml",
      "../../plugins/myssia-demo.yaml": "plugins/myssia-demo.yaml",
      "../../src/myssia": "myssia-src/myssia",
      "../entry.py": "myssia-src/entry.py",
      "../myssia_desktop_entry": "myssia-src/myssia_desktop_entry",
      "../resources/runtime-manifest.json": "runtime-manifest.json",
      "../resources/requirements-lock.txt": "requirements-lock.txt"
    },
    "category": "DeveloperTool",
    "shortDescription": "myssia — AI-native intelligence hub"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xinzhuzi/myia/releases/latest/download/latest.json"
      ],
      "pubkey": "__MYSSIA_UPDATER_PUBKEY_PLACEHOLDER__",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}